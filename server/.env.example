# ==============================================================================
# BTS SaaS Platform - Environment Variables
# Copy this file to .env and fill in the values before running the application.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV="development"

# Database Configuration (Supabase / PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?pgbouncer=true&connection_limit=1
# Example for Supabase: postgresql://postgres.[project]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/bts_db"
DIRECT_URL="postgresql://user:password@localhost:5432/bts_db" # Used for Prisma migrations if needed

# Authentication
# Generate a strong, random string for JWT encryption
JWT_SECRET="your_secure_jwt_secret_key_here"
JWT_EXPIRES_IN="24h"

# Notifications (Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="votre_email@gmail.com"
SMTP_PASS="votre_mot_de_passe_d_application"

# External APIs (Wave Payment Simulation / Production)
WAVE_API_KEY="your_wave_api_key_here"
WAVE_MERCHANT_ID="your_wave_merchant_id_here"
